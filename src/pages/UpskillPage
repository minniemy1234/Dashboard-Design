import React, { useState, useEffect, useMemo } from "react";
import Sidebar from "../components/Sidebar";
import { Layout, Card, Row, Col, Alert, Select as AntSelect, Spin, Empty, Tag, Table } from "antd";
import {
  RocketOutlined,
  DollarOutlined,
  TeamOutlined,
  ProjectOutlined,
  LockOutlined,
  RiseOutlined,
  FallOutlined,
  BarChartOutlined,
  FilterOutlined
} from "@ant-design/icons";
import {
  ComposedChart,
  BarChart,
  Bar,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip as RechartsTooltip,
  ResponsiveContainer,
  LabelList,
  Cell,
  Legend
} from "recharts";
import { db } from "../firebase";
import { doc, onSnapshot } from "firebase/firestore";

const { Header, Content } = Layout;

const REVENUE_COLORS = ["#0284c7", "#0d9488", "#059669", "#2563eb", "#7c3aed"];

const extractYear = (yearStr) => {
  if (!yearStr) return "";
  const match = String(yearStr).match(/\d{4}/);
  return match ? match[0] : "";
};

const parseNumber = (val) => {
  if (val === undefined || val === null || val === "") return 0;
  const cleaned = String(val).replace(/,/g, "").trim();
  const num = Number(cleaned);
  return isNaN(num) ? 0 : num;
};

function UpskillPage() {
  const [isAdmin, setIsAdmin] = useState(false);
  const [loading, setLoading] = useState(true);
  const [rawUpskillList, setRawUpskillList] = useState([]);
  const [selectedYearFilter, setSelectedYearFilter] = useState("ทั้งหมด");

  const currentEmail = (localStorage.getItem("email") || "").toLowerCase().trim();

  // เช็กสิทธิ์ Admin
  useEffect(() => {
    if (!db) {
      setIsAdmin(true);
      setLoading(false);
      return;
    }

    const unsub = onSnapshot(doc(db, "system_config", "admins"), (docSnap) => {
      let adminList = ["naramon.si@ku.th"];
      if (docSnap.exists() && Array.isArray(docSnap.data().list)) {
        adminList = Array.from(
          new Set(["naramon.si@ku.th", ...docSnap.data().list.map((e) => String(e).toLowerCase().trim())])
        );
      }
      setIsAdmin(adminList.includes(currentEmail));
      setLoading(false);
    });

    return () => unsub();
  }, [currentEmail]);

  // โหลดข้อมูล Upskill/Reskill จาก localStorage (รองรับทั้งไฟล์ที่มีหัวตารางปกติและหัวตารางซ้อน)
  useEffect(() => {
    const loadData = () => {
      const stored = localStorage.getItem("dashboardData");
      if (!stored) return;

      try {
        const parsed = JSON.parse(stored);
        const list =
          parsed["ข้อมูลวิจัย(Upskill)"] ||
          parsed["ข้อมูล Upskill-Reskill"] ||
          parsed["Upskill"] ||
          parsed["Reskill"] ||
          [];

        if (Array.isArray(list)) {
          // แปลงแถวข้อมูลให้เป็นมาตรฐานเดียวกัน ไม่ว่าจะอ่านจากคอลัมน์ภาษาไทย อังกฤษ หรือ Unnamed
          const normalized = list
            .map((row) => {
              const values = Object.values(row);
              const yearRaw =
                row["ปี พ.ศ."] ||
                row["Year"] ||
                row["การพัฒนาหลักสูตรระยะสั้นสนับสนุนการเรียนรู้ตลอดชีวิตและพัฒนาทักษะเพื่ออนาคต (Upskill-Reskill)"] ||
                values[0];

              const year = extractYear(yearRaw);
              if (!year) return null; // ข้ามแถวหัวตารางหรือแถวว่าง

              const projects = parseNumber(
                row["จำนวนโครงการ"] ?? row["Project_Count"] ?? row["Unnamed: 1"] ?? values[1]
              );
              const participants = parseNumber(
                row["จำนวนผู้เข้าร่วมโครงการ"] ?? row["Participant_Count"] ?? row["Unnamed: 2"] ?? values[2]
              );
              const revenue = parseNumber(
                row["รายได้"] ?? row["Revenue"] ?? row["Unnamed: 3"] ?? values[3]
              );

              return {
                year,
                projects,
                participants,
                revenue
              };
            })
            .filter(Boolean);

          // รวมข้อมูลกรณีมีปีซ้ำและเรียงลำดับปีจากน้อยไปมาก
          const yearMap = new Map();
          normalized.forEach((item) => {
            yearMap.set(item.year, item);
          });

          const sortedList = Array.from(yearMap.values()).sort((a, b) =>
            Number(a.year) - Number(b.year)
          );
          setRawUpskillList(sortedList);
        }
      } catch (e) {
        console.error("Error parsing Upskill data:", e);
      }
    };

    loadData();
    window.addEventListener("storage", loadData);
    return () => window.removeEventListener("storage", loadData);
  }, []);

  // คำนวณอัตราการเติบโตเทียบปีก่อนหน้า (YoY Growth) สำหรับแต่ละปี
  const enrichedData = useMemo(() => {
    return rawUpskillList.map((item, idx) => {
      const prev = idx > 0 ? rawUpskillList[idx - 1] : null;
      let revenueDiff = null;
      let revenueGrowthPct = null;

      if (prev && prev.revenue > 0) {
        revenueDiff = item.revenue - prev.revenue;
        revenueGrowthPct = ((revenueDiff / prev.revenue) * 100).toFixed(2);
      }

      return {
        ...item,
        yearLabel: `ปี ${item.year}`,
        revenueDiff,
        revenueGrowthPct: revenueGrowthPct !== null ? Number(revenueGrowthPct) : null
      };
    });
  }, [rawUpskillList]);

  // ข้อมูลที่กรองตาม Dropdown ปี (สำหรับ KPI และตาราง)
  const filteredTableData = useMemo(() => {
    if (selectedYearFilter === "ทั้งหมด") return enrichedData;
    return enrichedData.filter((d) => d.year === selectedYearFilter);
  }, [enrichedData, selectedYearFilter]);

  // สรุปตัวเลข KPI
  const kpiStats = useMemo(() => {
    if (enrichedData.length === 0) {
      return {
        latestYear: "-",
        latestRevenue: 0,
        latestGrowthPct: null,
        totalRevenue: 0,
        totalProjects: 0,
        totalParticipants: 0
      };
    }

    // ถ้าเลือกปีเจาะจง ให้โชว์ตัวเลขของปีนั้นเป็นหลัก
    const targetList = selectedYearFilter === "ทั้งหมด" ? enrichedData : filteredTableData;
    const focusItem = targetList[targetList.length - 1] || enrichedData[enrichedData.length - 1];

    const totalRevenue = targetList.reduce((sum, d) => sum + d.revenue, 0);
    const totalProjects = targetList.reduce((sum, d) => sum + d.projects, 0);
    const totalParticipants = targetList.reduce((sum, d) => sum + d.participants, 0);

    return {
      latestYear: focusItem.year,
      latestRevenue: focusItem.revenue,
      latestGrowthPct: focusItem.revenueGrowthPct,
      totalRevenue,
      totalProjects,
      totalParticipants
    };
  }, [enrichedData, filteredTableData, selectedYearFilter]);

  const tableColumns = [
    {
      title: "ปี พ.ศ.",
      dataIndex: "year",
      key: "year",
      align: "center",
      width: 110,
      render: (y) => <strong>พ.ศ. {y}</strong>
    },
    {
      title: "จำนวนโครงการ",
      dataIndex: "projects",
      key: "projects",
      align: "center",
      render: (v) => `${v.toLocaleString()} โครงการ`
    },
    {
      title: "จำนวนผู้เข้าร่วมโครงการ",
      dataIndex: "participants",
      key: "participants",
      align: "center",
      render: (v) => `${v.toLocaleString()} คน`
    },
    {
      title: "รายได้ (บาท)",
      dataIndex: "revenue",
      key: "revenue",
      align: "right",
      render: (v) => (
        <span style={{ color: "#0d9488", fontWeight: 700, fontSize: 15 }}>
          {v.toLocaleString("th-TH", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </span>
      )
    },
    {
      title: "เปรียบเทียบรายได้จากปีก่อนหน้า",
      key: "growth",
      align: "center",
      render: (_, record) => {
        if (record.revenueGrowthPct === null) {
          return <Tag color="default">ปีฐานเริ่มต้น</Tag>;
        }
        const isUp = record.revenueGrowthPct >= 0;
        return (
          <Tag
            color={isUp ? "success" : "error"}
            icon={isUp ? <RiseOutlined /> : <FallOutlined />}
            style={{ borderRadius: 6, fontWeight: 600, padding: "2px 10px" }}
          >
            {isUp ? "+" : ""}
            {record.revenueGrowthPct}% ({isUp ? "+" : ""}
            {record.revenueDiff.toLocaleString()} บ.)
          </Tag>
        );
      }
    }
  ];

  if (loading) {
    return (
      <div style={{ display: "flex", justifyContent: "center", alignItems: "center", minHeight: "100vh" }}>
        <Spin size="large" tip="กำลังโหลดข้อมูล..." />
      </div>
    );
  }

  return (
    <Layout style={{ minHeight: "100vh", background: "#f8fafc" }}>
      <Sidebar defaultSelectedKey="upskill" />
      <Layout style={{ background: "transparent" }}>
        {/* HEADER */}
        <Header
          style={{
            background: "#ffffff",
            padding: "0 24px",
            height: "64px",
            lineHeight: "64px",
            borderBottom: "1px solid #e2e8f0",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center"
          }}
        >
          <div style={{ display: "flex", alignItems: "baseline", gap: "12px" }}>
            <h2 style={{ margin: 0, fontSize: "18px", fontWeight: "700", color: "#142549", display: "flex", alignItems: "center" }}>
              <RocketOutlined style={{ color: "#0d9488", marginRight: 8 }} />
              Reskill / Upskill
            </h2>
            <span style={{ color: "#64748b", fontSize: "12px" }}>
              | การพัฒนาหลักสูตรระยะสั้นสนับสนุนการเรียนรู้ตลอดชีวิตและพัฒนาทักษะเพื่ออนาคต
            </span>
          </div>

          {/* Filter เลือกปี */}
          {enrichedData.length > 0 && (
            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
              <FilterOutlined style={{ color: "#64748b" }} />
              <span style={{ fontSize: 13, color: "#475569" }}>แสดงข้อมูลปี:</span>
              <AntSelect
                style={{ width: 140 }}
                value={selectedYearFilter}
                onChange={(val) => setSelectedYearFilter(val)}
              >
                <AntSelect.Option value="ทั้งหมด">ทุกปีงบประมาณ</AntSelect.Option>
                {enrichedData.map((d) => (
                  <AntSelect.Option key={d.year} value={d.year}>
                    ปี พ.ศ. {d.year}
                  </AntSelect.Option>
                ))}
              </AntSelect>
            </div>
          )}
        </Header>

        {/* CONTENT */}
        <Content style={{ padding: "24px", background: "#f8fafc" }}>
          {!isAdmin ? (
            <Alert
              message="ไม่มีสิทธิ์เข้าถึงข้อมูลส่วนนี้"
              description="หน้าจอนี้จำกัดเฉพาะผู้ดูแลระบบ (Admin) เท่านั้น"
              type="error"
              showIcon
              icon={<LockOutlined />}
              style={{ borderRadius: 16, padding: "20px 24px", maxWidth: 600, margin: "40px auto" }}
            />
          ) : enrichedData.length === 0 ? (
            <Card bordered={false} style={{ borderRadius: 16, textAlign: "center", padding: "40px 0" }}>
              <Empty description="ยังไม่มีข้อมูล Reskill / Upskill กรุณาอัปโหลดไฟล์ข้อมูลวิจัย(Upskill).csv ในหน้า Data Management" />
            </Card>
          ) : (
            <div style={{ display: "flex", flexDirection: "column", gap: 24 }}>
              {/* KPI SUMMARY CARDS */}
              <Row gutter={[20, 20]}>
                <Col xs={24} sm={12} lg={6}>
                  <Card
                    bordered={false}
                    style={{
                      borderRadius: 16,
                      background: "linear-gradient(135deg, #0f766e 0%, #0d9488 100%)",
                      color: "#fff",
                      boxShadow: "0 8px 20px -4px rgba(13, 148, 136, 0.25)"
                    }}
                  >
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                      <div>
                        <div style={{ fontSize: 12, color: "#ccfbf1", fontWeight: 600 }}>
                          รายได้ปี {kpiStats.latestYear}
                        </div>
                        <div style={{ fontSize: 26, fontWeight: 800, marginTop: 4 }}>
                          ฿{kpiStats.latestRevenue.toLocaleString()}
                        </div>
                        {kpiStats.latestGrowthPct !== null && (
                          <div style={{ marginTop: 6, fontSize: 12, color: "#fef08a", fontWeight: 600 }}>
                            {kpiStats.latestGrowthPct >= 0 ? "▲ เพิ่มขึ้น" : "▼ ลดลง"} {Math.abs(kpiStats.latestGrowthPct)}% จากปีก่อน
                          </div>
                        )}
                      </div>
                      <DollarOutlined style={{ fontSize: 32, color: "#99f6e4", opacity: 0.6 }} />
                    </div>
                  </Card>
                </Col>

                <Col xs={24} sm={12} lg={6}>
                  <Card bordered={false} style={{ borderRadius: 16, boxShadow: "0 4px 16px rgba(0,0,0,0.03)" }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                      <div>
                        <div style={{ fontSize: 12, color: "#64748b", fontWeight: 600 }}>
                          {selectedYearFilter === "ทั้งหมด" ? "รายได้รวมทุกปี" : `รายได้รวมปี ${selectedYearFilter}`}
                        </div>
                        <div style={{ fontSize: 26, fontWeight: 800, color: "#0284c7", marginTop: 4 }}>
                          ฿{kpiStats.totalRevenue.toLocaleString()}
                        </div>
                        <div style={{ marginTop: 6, fontSize: 12, color: "#94a3b8" }}>บาท</div>
                      </div>
                      <div style={{ background: "#e0f2fe", padding: 10, borderRadius: 12 }}>
                        <RiseOutlined style={{ fontSize: 22, color: "#0284c7" }} />
                      </div>
                    </div>
                  </Card>
                </Col>

                <Col xs={24} sm={12} lg={6}>
                  <Card bordered={false} style={{ borderRadius: 16, boxShadow: "0 4px 16px rgba(0,0,0,0.03)" }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                      <div>
                        <div style={{ fontSize: 12, color: "#64748b", fontWeight: 600 }}>จำนวนโครงการทั้งหมด</div>
                        <div style={{ fontSize: 26, fontWeight: 800, color: "#1e293b", marginTop: 4 }}>
                          {kpiStats.totalProjects.toLocaleString()}
                        </div>
                        <div style={{ marginTop: 6, fontSize: 12, color: "#94a3b8" }}>โครงการ</div>
                      </div>
                      <div style={{ background: "#fef3c7", padding: 10, borderRadius: 12 }}>
                        <ProjectOutlined style={{ fontSize: 22, color: "#d97706" }} />
                      </div>
                    </div>
                  </Card>
                </Col>

                <Col xs={24} sm={12} lg={6}>
                  <Card bordered={false} style={{ borderRadius: 16, boxShadow: "0 4px 16px rgba(0,0,0,0.03)" }}>
                    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
                      <div>
                        <div style={{ fontSize: 12, color: "#64748b", fontWeight: 600 }}>ผู้เข้าร่วมโครงการทั้งหมด</div>
                        <div style={{ fontSize: 26, fontWeight: 800, color: "#7c3aed", marginTop: 4 }}>
                          {kpiStats.totalParticipants.toLocaleString()}
                        </div>
                        <div style={{ marginTop: 6, fontSize: 12, color: "#94a3b8" }}>คน</div>
                      </div>
                      <div style={{ background: "#f3e8ff", padding: 10, borderRadius: 12 }}>
                        <TeamOutlined style={{ fontSize: 22, color: "#7c3aed" }} />
                      </div>
                    </div>
                  </Card>
                </Col>
              </Row>

              {/* CHARTS ZONE (2 กราฟเปรียบเทียบเคียงกัน) */}
              <Row gutter={[24, 24]}>
                {/* กราฟที่ 1: เปรียบเทียบรายได้รายปี */}
                <Col xs={24} lg={13}>
                  <Card
                    bordered={false}
                    style={{ borderRadius: 16, boxShadow: "0 4px 20px rgba(0,0,0,0.03)", height: "100%" }}
                    title={
                      <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                        <div style={{ background: "#ccfbf1", padding: "8px 12px", borderRadius: 10 }}>
                          <BarChartOutlined style={{ color: "#0d9488", fontSize: 18 }} />
                        </div>
                        <div>
                          <div style={{ fontSize: 15, fontWeight: 700, color: "#142549" }}>
                            เปรียบเทียบรายได้หลักสูตร Reskill / Upskill รายปี
                          </div>
                          <div style={{ fontSize: 12, color: "#94a3b8", fontWeight: 400 }}>
                            แสดงยอดรายได้ (บาท) และเส้นแนวโน้มการเติบโตแต่ละปี พ.ศ.
                          </div>
                        </div>
                      </div>
                    }
                  >
                    <div style={{ height: 320, width: "100%" }}>
                      <ResponsiveContainer width="100%" height="100%">
                        <ComposedChart data={enrichedData} margin={{ top: 25, right: 30, left: 10, bottom: 5 }}>
                          <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                          <XAxis
                            dataKey="yearLabel"
                            tick={{ fontSize: 12, fill: "#475569", fontWeight: 600 }}
                            axisLine={false}
                            tickLine={false}
                          />
                          <YAxis
                            tick={{ fontSize: 12, fill: "#64748b" }}
                            axisLine={false}
                            tickLine={false}
                            tickFormatter={(val) => `${(val / 1000).toLocaleString()}k`}
                          />
                          <RechartsTooltip
                            contentStyle={{ borderRadius: 10, border: "none", boxShadow: "0 4px 12px rgba(0,0,0,0.1)" }}
                            formatter={(val) => [`${Number(val).toLocaleString()} บาท`, "รายได้"]}
                          />
                          <Bar dataKey="revenue" name="รายได้ (บาท)" radius={[8, 8, 0, 0]} barSize={50}>
                            <LabelList
                              dataKey="revenue"
                              position="top"
                              style={{ fill: "#0f766e", fontSize: 12, fontWeight: 700 }}
                              formatter={(v) => `฿${Number(v).toLocaleString()}`}
                            />
                            {enrichedData.map((entry, idx) => (
                              <Cell key={`rev-${idx}`} fill={REVENUE_COLORS[idx % REVENUE_COLORS.length]} />
                            ))}
                          </Bar>
                          <Line
                            type="monotone"
                            dataKey="revenue"
                            stroke="#f59e0b"
                            strokeWidth={3}
                            dot={{ r: 5, fill: "#f59e0b", strokeWidth: 2, stroke: "#fff" }}
                          />
                        </ComposedChart>
                      </ResponsiveContainer>
                    </div>
                  </Card>
                </Col>

                {/* กราฟที่ 2: เปรียบเทียบจำนวนโครงการและผู้เข้าร่วม */}
                <Col xs={24} lg={11}>
                  <Card
                    bordered={false}
                    style={{ borderRadius: 16, boxShadow: "0 4px 20px rgba(0,0,0,0.03)", height: "100%" }}
                    title={
                      <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                        <div style={{ background: "#f3e8ff", padding: "8px 12px", borderRadius: 10 }}>
                          <TeamOutlined style={{ color: "#7c3aed", fontSize: 18 }} />
                        </div>
                        <div>
                          <div style={{ fontSize: 15, fontWeight: 700, color: "#142549" }}>
                            เปรียบเทียบจำนวนโครงการและผู้เข้าร่วม
                          </div>
                          <div style={{ fontSize: 12, color: "#94a3b8", fontWeight: 400 }}>
                            สถิติการเปิดอบรมและผู้เข้าอบรมรายปี
                          </div>
                        </div>
                      </div>
                    }
                  >
                    <div style={{ height: 320, width: "100%" }}>
                      <ResponsiveContainer width="100%" height="100%">
                        <BarChart data={enrichedData} margin={{ top: 25, right: 20, left: -10, bottom: 5 }}>
                          <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="#f1f5f9" />
                          <XAxis
                            dataKey="yearLabel"
                            tick={{ fontSize: 12, fill: "#475569", fontWeight: 600 }}
                            axisLine={false}
                            tickLine={false}
                          />
                          <YAxis tick={{ fontSize: 12, fill: "#64748b" }} axisLine={false} tickLine={false} />
                          <RechartsTooltip
                            contentStyle={{ borderRadius: 10, border: "none", boxShadow: "0 4px 12px rgba(0,0,0,0.1)" }}
                          />
                          <Legend verticalAlign="top" height={36} />
                          <Bar dataKey="projects" name="จำนวนโครงการ" fill="#f59e0b" radius={[6, 6, 0, 0]} barSize={28}>
                            <LabelList dataKey="projects" position="top" style={{ fill: "#b45309", fontSize: 12, fontWeight: 700 }} />
                          </Bar>
                          <Bar dataKey="participants" name="ผู้เข้าร่วม (คน)" fill="#8b5cf6" radius={[6, 6, 0, 0]} barSize={28}>
                            <LabelList dataKey="participants" position="top" style={{ fill: "#6d28d9", fontSize: 12, fontWeight: 700 }} />
                          </Bar>
                        </BarChart>
                      </ResponsiveContainer>
                    </div>
                  </Card>
                </Col>
              </Row>

              {/* TABLE ZONE */}
              <Card
                bordered={false}
                style={{ borderRadius: 16, boxShadow: "0 4px 20px rgba(0,0,0,0.03)" }}
                title={
                  <span style={{ fontSize: 15, fontWeight: 700, color: "#142549" }}>
                    ตารางสรุปผลการดำเนินงานและเปรียบเทียบรายได้รายปี
                  </span>
                }
              >
                <Table
                  dataSource={filteredTableData}
                  columns={tableColumns}
                  rowKey="year"
                  pagination={false}
                  bordered
                />
              </Card>
            </div>
          )}
        </Content>
      </Layout>
    </Layout>
  );
}

export default UpskillPage;
